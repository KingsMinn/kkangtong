# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_application_id_here
GUILD_ID=your_discord_server_id_here

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Environment Configuration
NODE_ENV=development  # development = SQLite, production = PostgreSQL

# ========================================
# 🔧 개발 환경 (SQLite) - 기본값
# ========================================
SQLITE_PATH=discord_secretary.sqlite

# ========================================
# 🚀 프로덕션 환경 (PostgreSQL) - 홈서버 배포용
# ========================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=discord_secretary
DB_USER=secretary_user
DB_PASSWORD=your_db_password

# Bot Configuration
BOT_PREFIX=!
PROACTIVE_CHECK_INTERVAL=*/30 * * * *  # Every 30 minutes

# AI Configuration
USE_GEMINI_PRO_THRESHOLD=0.7  # When to use Pro instead of Flash-lite (0-1)

# Optional: Redis Configuration (for caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Optional: Logging Configuration
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Optional: Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=15  # minutes

# ========================================
# 🎯 설정 가이드:
# ========================================
# 
# 📋 개발 단계 (SQLite 사용):
#    1. NODE_ENV=development (또는 설정 안 함)
#    2. Discord 토큰, Gemini API 키만 설정
#    3. npm run dev 실행
#    → SQLite 파일이 자동 생성됨!
# 
# 🚀 홈서버 배포 (PostgreSQL 사용):
#    1. NODE_ENV=production 설정
#    2. DB_* 변수들을 PostgreSQL 정보로 설정
#    3. docker-compose up -d 실행
# 
# 🔄 마이그레이션:
#    개발 완료 후 SQLite → PostgreSQL 데이터 이동 가능
# 
# ========================================
# 🛠️ Discord 봇 설정:
# ========================================
# 1. Discord 봇 생성:
#    - https://discord.com/developers/applications 방문
#    - 새 애플리케이션 생성 후 Bot 탭에서 토큰 복사
#    - General Information에서 APPLICATION ID 복사 (CLIENT_ID)
#    - Discord 서버에서 우클릭 → "서버 ID 복사" (GUILD_ID)
# 
# 2. Google Gemini API:
#    - https://makersuite.google.com/app/apikey 방문
#    - API 키 생성 후 복사
# 
# 3. 봇 권한 설정:
#    - Discord Developer Portal → OAuth2 → URL Generator
#    - Scopes: bot, applications.commands
#    - Bot Permissions: Send Messages, Use Slash Commands, Read Message History
# 
# ========================================
# 🚀 빠른 시작:
# ========================================
# 1. cp env.template .env
# 2. .env에서 Discord/Gemini 정보만 입력
# 3. npm install
# 4. npm run deploy (커맨드 등록)
# 5. npm run dev (개발 시작)
# 
# SQLite 파일이 자동으로 생성되고 기본 카테고리도 만들어집니다! 